.env
data/

.venv/
upstream/
runtime/
# 本地回滚包 / 临时工具 / 任务状态：体积大或为运行时产物，一律不入库。
# 仅"忽略"，不删除任何文件；如需单独入库某个工具，用 git add -f 或在此加白名单。
backups/
tools/
tasks/
# 本地运行数据（行情/回测/fuyao/任务状态等）一律不入库。
# 逐级反向白名单：仅放行自定义页面插件的代码产物，便于版本化与回滚，
# 不放开整个 data-local/，避免把数据或密钥带进仓库。
data-local/*
!data-local/ext_pages/
data-local/ext_pages/*
!data-local/ext_pages/local_chart/
data-local/ext_pages/local_chart/*
!data-local/ext_pages/local_chart/bundle.js
!data-local/ext_pages/local_chart/page.json
# 大单监控扩展页（2026-11-10 移植）：只放行页面代码两个产物，数据/采样不入库。
!data-local/ext_pages/big_order/
data-local/ext_pages/big_order/*
!data-local/ext_pages/big_order/bundle.js
!data-local/ext_pages/big_order/page.json
# 运行时自定义策略代码同样纳入版本管理（仅放行 .py，不放行配置/缓存）。
!data-local/strategies/
data-local/strategies/*
!data-local/strategies/custom/
data-local/strategies/custom/*
!data-local/strategies/custom/custom_qx175_etf_rotation.py
!data-local/strategies/custom/custom_simple_ma_cross.py

# 用户 2026-11-10 指令 11：「二开中非独立与 TSP 的都纳入」。
# 依附 TSP 运行的扩展页 / 本项目二开辅助脚本一律进版本库；
# 例外：tools/industry-report-skill/ 是带自己 .git 的第三方独立技能仓，
# 不属于本仓库二开产物，继续排除（tools/* 已覆盖）。
!data-local/ext_pages/industry_report/
data-local/ext_pages/industry_report/*
!data-local/ext_pages/industry_report/bundle.js
!data-local/ext_pages/industry_report/page.json
!tools/
tools/*
!tools/mining_bypass.py
!tools/regime_backfill.py
!tools/_mining_balanced_demo.py
__pycache__/
.pytest_cache/
.coverage
htmlcov/

# agent 状态目录（非程序代码，不入库）
.workbuddy/
.workbuddy-ai/
ref-doc/

# 大单监控 运行时产物（采样/巡检落盘，非源码，禁止入库）
services/bigorder_adapter/sampler/封单/
services/bigorder_adapter/sampler/state/
services/bigorder_adapter/watcher/大单提醒/
